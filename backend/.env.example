# Environment Configuration Settings for Scientific Management Backend

# Run mode: development or production
ENV=development

# Server connection options
HOST=0.0.0.0
PORT=10000

# Database Configuration
# Supported types: json (default)
DB_TYPE=json
DATABASE_URL=backend/data/db.json

# OpenAI API Settings
OPENAI_API_KEY=sk-proj-YOUR_API_KEY_HERE
OPENAI_MODEL=gpt-4o

# RAG Chatbot specific configurations
RAG_BATCH_SIZE=10
