# ==============================================================================
# Environment Configuration for Production Docker Deployment
# ==============================================================================

# Web & Port Configuration
WEB_PORT=80
POSTGRES_PORT=5432

# PostgreSQL Database Credentials
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_postgres_password_here
POSTGRES_DB=sci_management

# LLM & AI API Keys (Optional but recommended for RAG Chatbot & Paper Extraction)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
GEMINI_API_KEY=

# Security
SECRET_KEY=generate_a_random_secret_string_for_jwt_tokens
